generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures     = ["partialIndexes"]
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model alerts {
  id           String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  district_id  Int
  created_by   String                    @db.Uuid
  severity     alert_severity
  title        String
  message      String
  target_roles user_role[]               @default([])
  geofence     Unsupported("geography")?
  issued_at    DateTime                  @default(now()) @db.Timestamptz(6)
  expires_at   DateTime?                 @db.Timestamptz(6)
  cancelled_at DateTime?                 @db.Timestamptz(6)
  users        users                     @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  districts    districts                 @relation(fields: [district_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([district_id, issued_at(sort: Desc)], map: "alerts_district_issued_idx")
  @@index([geofence], map: "alerts_geofence_gist", type: Gist)
}

model audit_log {
  id          BigInt   @id @default(autoincrement())
  actor_id    String?  @db.Uuid
  action      String
  entity_type String
  entity_id   String
  metadata    Json     @default("{}")
  ip_address  String?  @db.Inet
  occurred_at DateTime @default(now()) @db.Timestamptz(6)
  users       users?   @relation(fields: [actor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([actor_id, occurred_at], map: "audit_log_actor_idx")
  @@index([entity_type, entity_id, occurred_at], map: "audit_log_entity_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model districts {
  id              Int                      @id @default(autoincrement())
  name            String
  state           String
  boundary        Unsupported("geography")
  population      Int?
  created_at      DateTime                 @default(now()) @db.Timestamptz(6)
  alerts          alerts[]
  facilities      facilities[]
  incidents       incidents[]
  rescue_teams    rescue_teams[]
  users           users[]
  villages        villages[]
  volunteer_tasks volunteer_tasks[]

  @@unique([state, name])
  @@index([boundary], map: "districts_boundary_gist", type: Gist)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model facilities {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  district_id        Int
  kind               facility_kind
  name               String
  location           Unsupported("geography")
  address            String?
  contact_phone      String?
  capacity           Int
  occupancy          Int                      @default(0)
  is_operational     Boolean                  @default(true)
  amenities          String[]                 @default([])
  attributes         Json                     @default("{}")
  created_at         DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at         DateTime                 @default(now()) @db.Timestamptz(6)
  districts          districts                @relation(fields: [district_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  facility_inventory facility_inventory[]
  users              users[]
  volunteer_tasks    volunteer_tasks[]

  @@index([district_id, kind], map: "facilities_district_kind_idx")
  @@index([location], map: "facilities_location_gist", type: Gist)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model facility_inventory {
  facility_id         String         @db.Uuid
  item                inventory_item
  quantity            Int            @default(0)
  low_stock_threshold Int?
  updated_at          DateTime       @default(now()) @db.Timestamptz(6)
  facilities          facilities     @relation(fields: [facility_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([facility_id, item])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model incident_reviews {
  id                                                        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incident_id                                               String        @db.Uuid
  reason                                                    review_reason
  related_incident_id                                       String?       @db.Uuid
  details                                                   Json          @default("{}")
  flagged_by                                                String?       @db.Uuid
  status                                                    review_status @default(PENDING)
  resolved_by                                               String?       @db.Uuid
  resolution_note                                           String?
  created_at                                                DateTime      @default(now()) @db.Timestamptz(6)
  resolved_at                                               DateTime?     @db.Timestamptz(6)
  users_incident_reviews_flagged_byTousers                  users?        @relation("incident_reviews_flagged_byTousers", fields: [flagged_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  incidents_incident_reviews_incident_idToincidents         incidents     @relation("incident_reviews_incident_idToincidents", fields: [incident_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  incidents_incident_reviews_related_incident_idToincidents incidents?    @relation("incident_reviews_related_incident_idToincidents", fields: [related_incident_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_incident_reviews_resolved_byTousers                 users?        @relation("incident_reviews_resolved_byTousers", fields: [resolved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([incident_id, reason], map: "incident_reviews_one_pending_per_reason_idx", where: raw("(status = 'PENDING'::review_status)"))
  @@index([created_at], map: "incident_reviews_pending_idx", where: raw("(status = 'PENDING'::review_status)"))
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model incident_status_log {
  id          BigInt           @id @default(autoincrement())
  incident_id String           @db.Uuid
  from_status incident_status?
  to_status   incident_status
  changed_by  String?          @db.Uuid
  note        String?
  changed_at  DateTime         @default(now()) @db.Timestamptz(6)
  users       users?           @relation(fields: [changed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  incidents   incidents        @relation(fields: [incident_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([incident_id, changed_at], map: "incident_status_log_incident_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model incidents {
  id                                                               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_uuid                                                      String                    @unique @db.Uuid
  district_id                                                      Int
  reporter_id                                                      String                    @db.Uuid
  type                                                             disaster_type             @default(OTHER)
  status                                                           incident_status           @default(REPORTED)
  is_sos                                                           Boolean                   @default(false)
  location                                                         Unsupported("geography")?
  location_source                                                  location_source
  location_accuracy_m                                              Float?                    @db.Real
  address_text                                                     String?
  description                                                      String?
  people_affected                                                  Int                       @default(1)
  has_elderly                                                      Boolean                   @default(false)
  has_children                                                     Boolean                   @default(false)
  has_injured                                                      Boolean                   @default(false)
  priority_score                                                   Decimal?                  @db.Decimal(5, 2)
  severity_level                                                   Int?                      @db.SmallInt
  duplicate_of                                                     String?                   @db.Uuid
  reported_at                                                      DateTime                  @db.Timestamptz(6)
  created_at                                                       DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at                                                       DateTime                  @default(now()) @db.Timestamptz(6)
  resolved_at                                                      DateTime?                 @db.Timestamptz(6)
  incident_reviews_incident_reviews_incident_idToincidents         incident_reviews[]        @relation("incident_reviews_incident_idToincidents")
  incident_reviews_incident_reviews_related_incident_idToincidents incident_reviews[]        @relation("incident_reviews_related_incident_idToincidents")
  incident_status_log                                              incident_status_log[]
  districts                                                        districts                 @relation(fields: [district_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  incidents                                                        incidents?                @relation("incidentsToincidents", fields: [duplicate_of], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_incidents                                                  incidents[]               @relation("incidentsToincidents")
  users                                                            users                     @relation(fields: [reporter_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  media                                                            media[]
  missions                                                         missions[]
  volunteer_tasks                                                  volunteer_tasks[]

  @@index([district_id, status, reported_at], map: "incidents_district_status_reported_idx")
  @@index([location], map: "incidents_location_gist", type: Gist)
  @@index([reporter_id, reported_at(sort: Desc)], map: "incidents_reporter_reported_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model media {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uploaded_by  String        @db.Uuid
  purpose      media_purpose
  incident_id  String?       @db.Uuid
  object_key   String        @unique
  content_type String
  size_bytes   BigInt?
  status       media_status  @default(PENDING)
  created_at   DateTime      @default(now()) @db.Timestamptz(6)
  confirmed_at DateTime?     @db.Timestamptz(6)
  incidents    incidents?    @relation(fields: [incident_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users        users         @relation(fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([incident_id])
  @@index([uploaded_by])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model missions {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incident_id         String                @db.Uuid
  team_id             String                @db.Uuid
  assigned_by         String                @db.Uuid
  status              mission_status        @default(ASSIGNED)
  eta_minutes         Int?
  rejection_reason    String?
  people_rescued      Int?
  injured_count       Int?
  hospital_required   Boolean?
  outcome_notes       String?
  assigned_at         DateTime              @default(now()) @db.Timestamptz(6)
  accepted_at         DateTime?             @db.Timestamptz(6)
  reached_at          DateTime?             @db.Timestamptz(6)
  completed_at        DateTime?             @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  users               users                 @relation(fields: [assigned_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  incidents           incidents             @relation(fields: [incident_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rescue_teams        rescue_teams          @relation(fields: [team_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  team_location_pings team_location_pings[]

  @@unique([incident_id, team_id], map: "missions_one_open_per_incident_team_idx", where: raw("(status = ANY (ARRAY['ASSIGNED'::mission_status, 'ACCEPTED'::mission_status, 'EN_ROUTE'::mission_status, 'ON_SITE'::mission_status]))"))
  @@index([incident_id])
  @@index([team_id, status], map: "missions_team_status_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model rescue_teams {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  district_id         Int
  name                String
  agency              rescue_agency
  team_size           Int
  capabilities        String[]                 @default([])
  base_location       Unsupported("geography")
  current_location    Unsupported("geography")
  location_updated_at DateTime?                @db.Timestamptz(6)
  is_available        Boolean                  @default(true)
  created_at          DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at          DateTime                 @default(now()) @db.Timestamptz(6)
  missions            missions[]
  districts           districts                @relation(fields: [district_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  team_location_pings team_location_pings[]
  users               users[]

  @@index([base_location], map: "rescue_teams_base_location_gist", type: Gist)
  @@index([current_location], map: "rescue_teams_current_location_gist", type: Gist)
  @@index([district_id])
}

model schema_migrations {
  version String @id @db.VarChar

  @@ignore
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
