  @@index([location], map: "team_location_pings_location_gist", type: Gist)
  @@index([team_id, recorded_at], map: "team_location_pings_team_recorded_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id                                                           String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone                                                        String                    @unique
  full_name                                                    String?
  role                                                         user_role                 @default(CITIZEN)
  district_id                                                  Int?
  rescue_team_id                                               String?                   @db.Uuid
  facility_id                                                  String?                   @db.Uuid
  password_hash                                                String?
  phone_verified_at                                            DateTime?                 @db.Timestamptz(6)
  last_location                                                Unsupported("geography")?
  last_location_at                                             DateTime?                 @db.Timestamptz(6)
  is_active                                                    Boolean                   @default(true)
  created_at                                                   DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at                                                   DateTime                  @default(now()) @db.Timestamptz(6)
  alerts                                                       alerts[]
  audit_log                                                    audit_log[]
  incident_reviews_incident_reviews_flagged_byTousers          incident_reviews[]        @relation("incident_reviews_flagged_byTousers")
  incident_reviews_incident_reviews_resolved_byTousers         incident_reviews[]        @relation("incident_reviews_resolved_byTousers")
  incident_status_log                                          incident_status_log[]
  incidents                                                    incidents[]
  media                                                        media[]
  missions                                                     missions[]
  districts                                                    districts?                @relation(fields: [district_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  facilities                                                   facilities?               @relation(fields: [facility_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rescue_teams                                                 rescue_teams?             @relation(fields: [rescue_team_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  volunteer_profiles_volunteer_profiles_reviewed_byTousers     volunteer_profiles[]      @relation("volunteer_profiles_reviewed_byTousers")
  volunteer_profiles_volunteer_profiles_user_idTousers         volunteer_profiles?       @relation("volunteer_profiles_user_idTousers")
  volunteer_tasks_volunteer_tasks_assigned_volunteer_idTousers volunteer_tasks[]         @relation("volunteer_tasks_assigned_volunteer_idTousers")
  volunteer_tasks_volunteer_tasks_created_byTousers            volunteer_tasks[]         @relation("volunteer_tasks_created_byTousers")

  @@index([last_location], map: "users_last_location_gist", type: Gist)
  @@index([role])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model villages {
