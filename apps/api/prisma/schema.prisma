/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model volunteer_profiles {
  user_id                                     String              @id @db.Uuid
  skills                                      String[]            @default([])
  is_available                                Boolean             @default(true)
  service_radius_km                           Int                 @default(10) @db.SmallInt
  verification_status                         verification_status @default(PENDING)
  reviewed_by                                 String?             @db.Uuid
  reviewed_at                                 DateTime?           @db.Timestamptz(6)
  rejection_reason                            String?
  created_at                                  DateTime            @default(now()) @db.Timestamptz(6)
  updated_at                                  DateTime            @default(now()) @db.Timestamptz(6)
  users_volunteer_profiles_reviewed_byTousers users?              @relation("volunteer_profiles_reviewed_byTousers", fields: [reviewed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_volunteer_profiles_user_idTousers     users               @relation("volunteer_profiles_user_idTousers", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([skills], map: "volunteer_profiles_skills_gin", type: Gin)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model volunteer_tasks {
  id                                                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  district_id                                        Int
  created_by                                         String                   @db.Uuid
  incident_id                                        String?                  @db.Uuid
  facility_id                                        String?                  @db.Uuid
  title                                              String
  description                                        String?
  required_skills                                    String[]                 @default([])
  location                                           Unsupported("geography")
  status                                             volunteer_task_status    @default(OPEN)
  assigned_volunteer_id                              String?                  @db.Uuid
  created_at                                         DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at                                         DateTime                 @default(now()) @db.Timestamptz(6)
  accepted_at                                        DateTime?                @db.Timestamptz(6)
  completed_at                                       DateTime?                @db.Timestamptz(6)
  users_volunteer_tasks_assigned_volunteer_idTousers users?                   @relation("volunteer_tasks_assigned_volunteer_idTousers", fields: [assigned_volunteer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_volunteer_tasks_created_byTousers            users                    @relation("volunteer_tasks_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  districts                                          districts                @relation(fields: [district_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  facilities                                         facilities?              @relation(fields: [facility_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  incidents                                          incidents?               @relation(fields: [incident_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([location], map: "volunteer_tasks_location_gist", type: Gist)
  @@index([district_id], map: "volunteer_tasks_open_district_idx", where: raw("(status = 'OPEN'::volunteer_task_status)"))
  @@index([assigned_volunteer_id, status], map: "volunteer_tasks_volunteer_status_idx")
}

enum alert_severity {
  MINOR
  MODERATE
  SEVERE
  EXTREME
}

enum disaster_type {
  FLOOD
  EARTHQUAKE
  FIRE
  CYCLONE
  LANDSLIDE
  BUILDING_COLLAPSE
  OTHER
}

enum facility_kind {
  SHELTER
  HOSPITAL
}

enum incident_status {
  REPORTED
  VERIFIED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REJECTED_DUPLICATE
  REJECTED_FAKE
}

enum inventory_item {
  FOOD_PACKET
  WATER_LITRE
  MEDICAL_KIT
  BLANKET
}

enum location_source {
  GPS
  MANUAL_PIN
  NONE
}

enum media_purpose {
  INCIDENT_ATTACHMENT
  VOLUNTEER_DOCUMENT
}

enum media_status {
  PENDING
  CONFIRMED
}

enum mission_status {
  ASSIGNED
  ACCEPTED
  REJECTED
  EN_ROUTE
  ON_SITE
  COMPLETED
  CANCELLED
}

enum rescue_agency {
  NDRF
  SDRF
  FIRE
  POLICE
  HEALTH
  OTHER
}

enum review_reason {
  POSSIBLE_DUPLICATE
  POSSIBLE_FAKE
  LOCATION_UNCERTAIN
  OTHER
}

enum review_status {
  PENDING
  RESOLVED
}

enum user_role {
  CITIZEN
  VOLUNTEER
  RESCUE_TEAM
  FACILITY_MANAGER
  GOVT_OFFICIAL
}

enum verification_status {
  PENDING
  VERIFIED
  REJECTED
}

enum volunteer_task_status {
  OPEN
  ACCEPTED
  COMPLETED
  CANCELLED
}
