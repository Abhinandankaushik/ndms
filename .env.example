# Copy to .env. Values here are local-development defaults only.

COMPOSE_FILE=infra/docker-compose.yml

POSTGRES_USER=ndms
POSTGRES_PASSWORD=ndms-dev-password
POSTGRES_DB=ndms
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=ndms
MINIO_ROOT_PASSWORD=ndms-dev-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MQTT_PORT=1883

API_PORT=3000
WEB_ORIGIN=http://localhost:3001

# At least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-before-any-real-use
# There is no SMS gateway in the Minor build, so every login accepts this fixed OTP.
OTP_DEV_CODE=123456
# true only behind HTTPS; phones on http://<lan-ip> drop Secure cookies.
COOKIE_SECURE=false

# Read by the API when it runs on the host (pnpm api:dev). Inside Docker Compose
# these are rebuilt from the values above with service hostnames, so keep the
# credentials in sync with POSTGRES_* and MINIO_ROOT_*.
DATABASE_URL=postgresql://ndms:ndms-dev-password@localhost:5432/ndms
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
# Host the browser uses for presigned upload URLs (set to http://<lan-ip>:9000 for phone testing).
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=ndms
S3_SECRET_ACCESS_KEY=ndms-dev-password
S3_BUCKET=ndms-media
S3_FORCE_PATH_STYLE=true
